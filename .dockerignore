# flyctl launch added from .gitignore
# Python caches and virtual environments
**/__pycache__
**/*.py[cod]
**/*$py.class
**/.venv
**/venv
**/.pytest_cache

# Local checkpoints and logs
logs/
checkpoints/*
!checkpoints/best_model.pt
!checkpoints/large_v5_fixed_mcts
!checkpoints/large_v3_pure_self_play
**/*.txt
**/*.log
# flyctl launch added from .pytest_cache/.gitignore
# Created by pytest automatically.
.pytest_cache/**/*

# flyctl launch added from .venv/.gitignore
# Created by venv; see https://docs.python.org/3/library/venv.html
.venv/**/*
fly.toml

# Exclude large local directories
.git/
.vscode/
.idea/
